# Copia estos nombres a las Variables de Railway — nunca subas un .env real a GitHub.

# Tu llave de Anthropic — paga todos los mensajes de todos los miembros (centralizado)
ANTHROPIC_API_KEY=

# Del proyecto vaas-closer-bot en Supabase (Project Settings -> API)
SUPABASE_URL=
# OJO: esta es la "service_role" key, NO la "anon" key — esta sí tiene permiso total,
# nunca la pongas en el sitio web ni la compartas, solo vive aquí en el motor.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000

# Ventana de envío (hora de Chicago) y tiempos de espera — ya vienen con buenos valores por default
CHECK_INTERVAL_MINUTES=30
HOURS_BEFORE_MESSAGE_2=24
HOURS_BEFORE_ACCEPT_LAST_OFFER=24
SEND_WINDOW_START_HOUR_CT=22
SEND_WINDOW_END_HOUR_CT=7

# Minutos que espera el bot juntando mensajes seguidos antes de contestar
REPLY_DEBOUNCE_MINUTES=12
